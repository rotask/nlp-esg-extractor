# Copy this file to `.env` and fill in the values you need. The pipeline
# loads `.env` via python-dotenv at startup. Do NOT commit the real `.env`
# file; it is git-ignored.

# ---------------------------------------------------------------------------
# Required by default
# ---------------------------------------------------------------------------

# Which LLM backend the LLM extractor talks to. One of: anthropic, gemini.
# Defaults to "anthropic" if unset.
LLM_PROVIDER=anthropic

# Sentence-embedding model used by the retrieval layer. One of:
# climatebert (768-dim ClimateBERT, default — best recall on this corpus)
# minilm     (384-dim MiniLM-L6, faster, ~3 pp lower retrieval recall).
EMBEDDING_MODEL=climatebert

# ---------------------------------------------------------------------------
# Anthropic provider — required iff LLM_PROVIDER=anthropic
# ---------------------------------------------------------------------------

# Anthropic API key. Get one at https://console.anthropic.com.
ANTHROPIC_API_KEY=sk-ant-...

# Anthropic model id. Defaults to claude-sonnet-4-6 in code.
ANTHROPIC_MODEL=claude-sonnet-4-6

# ---------------------------------------------------------------------------
# Gemini provider — required iff LLM_PROVIDER=gemini
# ---------------------------------------------------------------------------

# Google AI Studio API key. Get one at https://aistudio.google.com/apikey.
# GOOGLE_API_KEY is also accepted as a fallback variable name.
GEMINI_API_KEY=...

# Gemini model id. Recommended: gemini-2.5-flash (best results on this corpus).
# Alternative: gemini-2.5-flash-lite (cheaper, ~1 pp lower F1).
GEMINI_MODEL=gemini-2.5-flash

# ---------------------------------------------------------------------------
# Process-level env vars (NOT loaded from .env — must be exported in shell)
# ---------------------------------------------------------------------------
# NLP_ESG_DISABLE_DOCLING=1
#   Skip the Docling-first ingest path and use pdfplumber only. Required on
#   machines where Docling's C++ layout model SIGSEGVs on long PDFs (it does
#   on the dev machine for this corpus). Set as a shell env var, e.g.:
#       NLP_ESG_DISABLE_DOCLING=1 python -m nlp_esg.pipeline --run-tag my_run
